GOOGLE_API_KEY=your_google_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_existing_dense_cosine_index

# Uses models/gemini-embedding-001 without overriding dimensionality.
# Measured here: 3072, validated again at runtime before writes.
# No automatic index creation or selection of a cloud/region.

RERANK_ENABLED=false
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=4
# Optional durable local manifest directory; never share an ephemeral directory
# among deployments. Keep this private and back it up with the original PDFs.
# DOCUSENSE_STATE_DIR=/absolute/private/path/.docusense

# Chat provider; Gemini remains the embedding provider for both options.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
